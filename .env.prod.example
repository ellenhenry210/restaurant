# Real production secrets for docker-compose.prod.yml. Copy to `.env` in
# this same directory (docker compose reads `.env` next to the compose
# file automatically) and fill in real values — never commit the actual
# `.env`.

DB_NAME=snaporder
DB_USER=snaporder_user
DB_PASSWORD=change_me_to_a_real_secret

RABBITMQ_USER=change_me
RABBITMQ_PASSWORD=change_me_to_a_real_secret

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_real_random_secret_at_least_32_chars
JWT_EXPIRY=6h
GUEST_SESSION_EXPIRY=4h

PAYSTACK_API_KEY=sk_live_xxxxx
PAYSTACK_WEBHOOK_SECRET=xxxxx

GUEST_APP_BASE_URL=https://snaporder.app
