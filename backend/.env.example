# Server
PORT=3000
NODE_ENV=development

# Comma-separated allowlist of origins allowed to call this API
# cross-origin (backend/src/app.js). Defaults to Vite's dev port if unset.
CORS_ORIGIN=http://localhost:5173

# Database
# Port 5433, not Postgres's usual 5432 — this project's docker-compose.yml
# maps its Postgres container to 5433 specifically to avoid clashing with
# a native/system Postgres install that may already be using 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=snaporder
DB_USER=snaporder_user
DB_PASSWORD=changeme_in_local_env
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_32_chars_long
JWT_EXPIRY=24h
GUEST_SESSION_EXPIRY=4h
# No separate "default proximity radius" env var: that default (150m)
# lives on the restaurants.max_guest_distance_meters column itself
# (migration 003), since it's genuinely per-restaurant, not global.

# Paystack
PAYSTACK_API_KEY=sk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=xxxxx

# Guest-facing app — the domain a table's QR code links to
# (backend/src/controllers/qrController.js). No frontend is deployed yet;
# this is the eventual production domain, overridable per environment.
GUEST_APP_BASE_URL=https://snaporder.app

# Staff-facing app — used to build the link inside a password-reset email
# (backend/src/routes/auth.js). Same "no frontend deployed yet" caveat.
APP_BASE_URL=https://snaporder.app

# SMTP (password reset emails — backend/src/notifications.js). Leave
# SMTP_HOST unset to keep the current dev-safe default: emails are
# logged, not sent, rather than failing loudly with placeholder creds.
# Works with any provider that offers plain SMTP (SendGrid, Postmark,
# Mailgun, Amazon SES, etc.) — no vendor-specific SDK required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@snaporder.app

# AWS S3 (for images)
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=snaporder-images
AWS_REGION=eu-west-1