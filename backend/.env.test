# Test environment — a SEPARATE database on the same local Postgres
# instance/container (never the dev database: tests truncate tables
# between runs, which would wipe real dev data). Never used outside
# local/CI test runs; not loaded by the app itself, only by
# tests/setupEnv.js.
NODE_ENV=test

DB_HOST=localhost
DB_PORT=5433
DB_NAME=snaporder_test
DB_USER=snaporder_user
DB_PASSWORD=changeme_in_local_env
DB_SSL=false

JWT_SECRET=guyffjhyy87*!@$#@gdyASR545
JWT_EXPIRY=6h
GUEST_SESSION_EXPIRY=4h

# Fake — never actually called with a real network request. Tests that
# exercise Paystack initialize mock global.fetch instead of hitting the
# real API (see tests/integration/payments.test.js).
PAYSTACK_API_KEY=sk_test_fake_for_unit_tests
PAYSTACK_WEBHOOK_SECRET=test_webhook_secret

GUEST_APP_BASE_URL=https://snaporder.app
